{
  "name": "xynes-storage-service",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.7.4"
  },
  "scripts": {
    "dev": "bun run scripts/run-with-env.ts run --watch src/index.ts",
    "start": "bun run scripts/run-with-env.ts run src/index.ts",
    "test": "bun run scripts/run-with-env.ts test",
    "test:coverage": "bun run scripts/run-with-env.ts run scripts/test-coverage-gate.ts",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'tests/**/*.ts' --fix",
    "typecheck": "tsc --noEmit",
    "db:check": "bun run scripts/db-check.ts"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/s3-request-presigner": "^3.658.0",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.10.8",
    "postgres": "^3.4.7",
    "sharp": "^0.34.5",
    "zod": "^4.2.1"
  }
}
