# Dockerfile-specific allowlist, independent of any local .dockerignore.
**
!package.json
!bun.lock
# Needed by the development test suite; never copied into the prod stage.
!Dockerfile
!src/
src/**
!src/**/*.ts
!scripts/
scripts/**
!scripts/**/*.ts
!tests/
!tests/**
!tsconfig.json
!.eslintrc*
!.prettier*
# Never admit host dependencies, env files, credentials or generated evidence.
**/node_modules
**/node_modules/**
**/.env
**/.env.*
**/.git
**/.git/**
**/coverage
**/coverage/**
**/*.log
# Private material is excluded even under otherwise admitted runtime/test paths.
**/.aws
**/.aws/**
**/.ssh
**/.ssh/**
**/.npmrc
**/.netrc
**/*.pem
**/*.key
**/*.p12
**/*.pfx
