# =============================================================================
# xynes-storage-service — local-dev env
# =============================================================================
#
# This service's runtime env is sourced from the canonical workspace template:
#   ../xynes-infra/.env.example
#
# That template documents every storage env key (R2 / B2 / iDrive e2 provisioning,
# `STORAGE_PROCESSOR_MODE` semantics, ClamAV sidecar wiring, LibreOffice sidecar
# wiring, the `STORAGE_CREDENTIAL_*` resolver convention from STORAGE-FU-3)
# with security notes and cross-references to the architecture epics.
#
# Copy it to one of:
#   ../xynes-infra/.env.dev          (Docker dev stack)
#   ../xynes-infra/.env.localhost    (host-run scripts / tests)
#
# When running host-side scripts in this repo (bun run dev, bun test):
#   export XYNES_ENV_FILE=../xynes-infra/.env.localhost
# or symlink one of the canonical files via xynes-infra/scripts/link-env-files.sh.
#
# Both `.env.dev` and `.env.localhost` are git-ignored across this workspace.
# NEVER commit real values into either filename.
#
# Canonical structure + 3-level layering (local / VPS dev/qa/prod / future
# hosted secret manager):
#   ../xynes-infra/ENV_GUIDE.md
#   ../xynes-infra/infra/release/SECRETS.md
#
# Universal Object Storage architecture:
#   ../xynes-infra/docs/plans/archive/2026-05-10-universal-object-storage-file-upload-api.md
# =============================================================================

# -----------------------------------------------------------------------------
# Keys this service reads at runtime
# -----------------------------------------------------------------------------
# Placeholders below are intentionally NON-FUNCTIONAL — replace from the
# canonical template. The list below is the runtime contract; for provisioning
# steps (R2 / B2 onboarding, sidecar setup, processor mode flip) see the plan
# archive referenced above and `docs/deployment-posture.md` in this repo.

# HTTP port. Reserved 4204 (see DEVELOPER.md "Story status").
PORT=4204

# Internal auth posture (matches the rest of the service mesh).
#   `hybrid` accepts both the legacy static token and a future signed JWT
#   `jwt` requires a JWT and fails closed if INTERNAL_JWT_SIGNING_KEY is missing.
INTERNAL_AUTH_MODE=hybrid

# Shared service-to-service auth token (legacy path).
INTERNAL_SERVICE_TOKEN=replace-with-openssl-rand-hex-32

# Internal JWT signing key (SEC-INTERNAL-AUTH-2). MUST match the value the
# gateway uses to sign internal calls.
INTERNAL_JWT_SIGNING_KEY=replace-with-openssl-rand-hex-32

# Postgres connection. Repos share DATABASE_URL with the rest of the platform.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# Processor mode. `stub` (default outside production) runs deterministic
# in-memory stubs; `live` wires sharp / ffmpeg / LibreOffice / ClamAV.
# See docs/deployment-posture.md before flipping to `live`.
STORAGE_PROCESSOR_MODE=stub

# ClamAV sidecar endpoint (only consulted when STORAGE_PROCESSOR_MODE=live).
CLAMD_HOST=clamav-clamd
CLAMD_PORT=3310

# LibreOffice sidecar endpoint (optional in live mode). If unset, document-
# preview jobs surface as PROCESSOR_FAILED (safe-fail) instead of crashing.
# LIBREOFFICE_SERVICE_URL=http://libreoffice-sidecar:8100

# -----------------------------------------------------------------------------
# Storage provider credentials (STORAGE-FU-3 EnvSecretManagerClient convention)
# -----------------------------------------------------------------------------
# The storage-service resolves credentials at runtime via the `credential_ref`
# column on `platform.workspace_storage_providers`. The env-var naming
# convention is:
#
#   `secret://xynes/storage/<provider>-<env>` →
#     STORAGE_CREDENTIAL_XYNES__STORAGE__<PROVIDER>_<ENV>_ACCESS_KEY_ID
#     STORAGE_CREDENTIAL_XYNES__STORAGE__<PROVIDER>_<ENV>_SECRET_ACCESS_KEY
#
# This local-dev path (EnvSecretManagerClient) is for `bun run dev` only.
# Hosted environments wire a real `SecretManagerClient` (AWS Secrets Manager /
# Doppler / Vault / Infisical / GCP Secret Manager) — see SECRETS.md
# §"Hosted secrets resolution path".
#
# Cloudflare R2 (default hosted provider for STORAGE-LIVE-1):
STORAGE_CREDENTIAL_XYNES__STORAGE__R2_DEV_ACCESS_KEY_ID=replace-with-cloudflare-r2-access-key-id
STORAGE_CREDENTIAL_XYNES__STORAGE__R2_DEV_SECRET_ACCESS_KEY=replace-with-cloudflare-r2-secret-access-key

# Backblaze B2 (deferred to STORAGE-LIVE-6):
# STORAGE_CREDENTIAL_XYNES__STORAGE__B2_DEV_ACCESS_KEY_ID=
# STORAGE_CREDENTIAL_XYNES__STORAGE__B2_DEV_SECRET_ACCESS_KEY=
