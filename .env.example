# =============================================================================
# xynes-storage-service runtime environment example.
#
# Copy to `.env.dev` (or `.env.dev.local`) and fill in values. `.env*` files
# are git-ignored. NEVER commit a populated copy of this file.
#
# Source of truth for provider provisioning:
#   xynes-infra/docs/plans/2026-05-13-storage-provider-env-values-worksheet.md
# Architecture + multi-provider quirks table:
#   xynes-infra/docs/plans/2026-05-10-universal-object-storage-file-upload-api.md §3
# =============================================================================


# -----------------------------------------------------------------------------
# Storage service runtime — port + internal auth
# -----------------------------------------------------------------------------

# HTTP port. Reserved 4204 (see DEVELOPER.md "Story status" + plan §STORAGE-1).
PORT=4204

# Internal auth posture. `hybrid` accepts both the legacy static token and a
# future signed JWT (matches `xynes-accounts-service`); `jwt` requires a JWT
# and fails closed if the signing key is missing.
INTERNAL_AUTH_MODE=hybrid

# Legacy static token shared with `xynes-gateway`. Replace before any non-local
# environment. Production deployments will switch to `INTERNAL_AUTH_MODE=jwt`.
INTERNAL_SERVICE_TOKEN=replace_me_dev_only

# Multipart threshold in bytes (default 100 MiB per AWS guidance).
STORAGE_MULTIPART_THRESHOLD_BYTES=104857600


# =============================================================================
# Universal Object Storage — STORAGE-4 (capture during provisioning)
# =============================================================================
#
# These env values feed `platform.workspace_storage_providers` rows when a
# workspace is provisioned. The schema is the same for every S3-compatible
# provider — only the values differ. See:
#   - docs/plans/2026-05-10-universal-object-storage-file-upload-api.md §3
#   - docs/plans/2026-05-13-storage-provider-env-values-worksheet.md
#
# Security rules:
#   - Never commit a populated copy of this file (`.env.*` is git-ignored).
#   - Raw access keys and secret keys should migrate to a real secret manager
#     before hosted rollout. The storage-service will read them via the
#     `credential_ref` column on `platform.workspace_storage_providers`, not
#     directly from env. For STORAGE-4 development against local + dev R2,
#     raw env values are acceptable in a git-ignored `.env.dev` / `.env.dev.local`.
#   - Never paste keys into chat, PR comments, or commit history. If a key
#     ever appears in any of those, rotate it at the provider immediately.
# =============================================================================


# -----------------------------------------------------------------------------
# Cloudflare R2 — default hosted provider for STORAGE-4
# -----------------------------------------------------------------------------
# Provision steps:
#   1. Cloudflare dashboard → R2 → Overview → copy Account ID (32 hex chars).
#   2. R2 → Create bucket → name = R2_BUCKET below.
#   3. R2 → Manage API tokens → Create API token → "Object Read & Write" →
#      scope to the bucket → copy access key id + secret access key ONCE.
# -----------------------------------------------------------------------------

# 32-char hex Cloudflare Account ID.
R2_ACCOUNT_ID=00000000000000000000000000000000

# Bucket name. Suggested convention: xynes-storage-<env>.
R2_BUCKET=xynes-storage-dev

# R2 region MUST be `auto`. Empty string and `us-east-1` also alias to `auto`.
R2_REGION=auto

# Derived endpoint host — uncomment after R2_ACCOUNT_ID is filled in.
# R2_ENDPOINT=https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com

# Optional storage class. R2 supports `STANDARD` and `STANDARD_IA`.
R2_STORAGE_CLASS=STANDARD

# Token credentials (shown once at creation in the Cloudflare console).
# Replace inline for local dev only; production values must come from the
# secret manager via `credential_ref`.
R2_ACCESS_KEY_ID=replace-with-cloudflare-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-cloudflare-r2-secret-access-key

# Secret-manager pointer recorded in `platform.workspace_storage_providers.credential_ref`.
# The pointer itself is safe to commit; the values it resolves to are NOT.
R2_CREDENTIAL_REF=secret://xynes/storage/r2-dev


# -----------------------------------------------------------------------------
# MinIO — opt-in local dev (NOT auto-provisioned by docker-compose.dev.yml)
# -----------------------------------------------------------------------------
# MinIO is NOT a required local-dev runtime. STORAGE-4/5/6 tests use fakes via
# the `S3StorageProviderAdapterDeps` DI seam, so no live provider is needed.
# STORAGE-12's smoke harness defaults to `STORAGE_SMOKE_PROVIDER=r2` against a
# hosted R2 dev bucket.
#
# These values document the supported config shape for operators who want to
# exercise the adapter end-to-end without R2 credentials. Run MinIO ad-hoc:
#
#   docker run -d --name xynes-minio-local \
#     -p 9000:9000 -p 9001:9001 \
#     -e MINIO_ROOT_USER=xynes_dev_admin \
#     -e MINIO_ROOT_PASSWORD=xynes_dev_password_change_me \
#     -v xynes-minio-data:/data \
#     quay.io/minio/minio server /data --console-address ":9001"
#
#   mc alias set xynes-local http://localhost:9000 \
#     xynes_dev_admin xynes_dev_password_change_me
#   mc mb xynes-local/xynes-storage-local
# -----------------------------------------------------------------------------

# Use http://localhost:9000 when running MinIO ad-hoc on your host.
# Use http://minio:9000 only when storage-service runs inside the same compose
# network as a MinIO container (not part of any canonical compose file).
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=xynes-storage-local
MINIO_FORCE_PATH_STYLE=true
MINIO_CREDENTIAL_REF=secret://xynes/storage/minio-local


# -----------------------------------------------------------------------------
# Backblaze B2 — alternate hosted provider (deferred; captured for later)
# -----------------------------------------------------------------------------
# Provision steps:
#   1. Backblaze console → Buckets → Create a Bucket → Private →
#      name = B2_BUCKET below (no underscores; `b2-` prefix reserved).
#   2. App Keys → Add a New Application Key → scope to the bucket →
#      permissions `readWrite + listBuckets + listFiles` → copy ID + key ONCE.
# B2-specific quirks (already baked into STORAGE-4 / 9):
#   - SigV4 only (v2 rejected).
#   - `x-amz-tagging` on PUT/Copy is rejected.
#   - No browser POST form uploads.
#   - CORS XML ≤ 100 KB, MaxAgeSeconds ∈ [0, 86400], non-empty AllowedOrigin.
# -----------------------------------------------------------------------------

# Real region — NOT `auto`. Example: us-east-005, eu-central-003.
# B2_REGION=us-east-005

# Bucket name. Suggested convention: xynes-storage-<env>-b2.
# B2_BUCKET=xynes-storage-dev-b2

# Derived endpoint host — uncomment after B2_REGION is filled in.
# B2_ENDPOINT=https://s3.${B2_REGION}.backblazeb2.com

# Application Key credentials (shown once at creation in the Backblaze console).
# B2_ACCESS_KEY_ID=replace-with-backblaze-b2-application-key-id
# B2_SECRET_ACCESS_KEY=replace-with-backblaze-b2-application-key

# Secret-manager pointer for B2 credentials.
# B2_CREDENTIAL_REF=secret://xynes/storage/b2-dev


# -----------------------------------------------------------------------------
# iDrive e2 — alternate hosted provider (deferred indefinitely)
# -----------------------------------------------------------------------------
# Capture only when a workspace adopts e2. Onboarding gate: a region MUST be
# enabled via Dashboard → Regions dropdown → "Enable" BEFORE the "Create Bucket"
# CTA appears in the e2 console. See the worksheet for full provisioning steps.
#
# e2-specific quirks (already baked into STORAGE-4 / 9):
#   - SigV4 only even though e2 also accepts v2 — adapter never emits v2.
#   - CORS payload format is JSON (per-bucket "Bucket CORS" tab), not XML;
#     adapter serialises per provider, callers see the normalised shape.
#   - Public-bucket creation is support-ticket gated for accounts created after
#     2024-11-01; we always create Private, so this does not block us.
# -----------------------------------------------------------------------------

# Real region — NOT `auto`. e.g. Frankfurt, Singapore.
# E2_REGION=

# Per-account, per-region endpoint host shown under Dashboard → Enabled regions
# after the region has been enabled. NOT derivable from E2_REGION alone.
# E2_ENDPOINT=

# Bucket name. Suggested convention: xynes-storage-<env>-e2.
# E2_BUCKET=xynes-storage-dev-e2

# Access key credentials (shown once at creation in the e2 Access Keys tab).
# E2_ACCESS_KEY_ID=
# E2_SECRET_ACCESS_KEY=

# Secret-manager pointer for e2 credentials.
# E2_CREDENTIAL_REF=secret://xynes/storage/idrive-e2-dev
